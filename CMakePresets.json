{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cmake43",
      "toolchainFile": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "ON",
        "QC_PRECOMPILE_GCC_STDLIB_MODULES": "ON"
      }
    },
    {
      "name": "gcc16-ninja",
      "inherits": "base",
      "displayName": "GCC 16 + Ninja (C++23 modules, CUDA llama-server)",
      "description": "Full local build: gateway plus the bundled llama-server with CUDA. nvcc is discovered from CUDACXX/PATH/CUDA_PATH rather than a pinned path, so a toolkit upgrade cannot brick the tree.",
      "cacheVariables": {
        "QC_BUILD_LLAMA_SERVER": "ON",
        "GGML_CUDA": "ON",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "gcc16-ninja-nocuda",
      "inherits": "base",
      "displayName": "GCC 16 + Ninja (gateway only, no llama.cpp/CUDA)",
      "description": "Gateway and test suite only. Skips the bundled llama.cpp subtree entirely, so no CUDA toolchain is required. Use for fast iteration and CI; the gateway still talks to an externally-run llama-server over HTTP.",
      "binaryDir": "${sourceDir}/build-nocuda",
      "cacheVariables": {
        "QC_BUILD_LLAMA_SERVER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc16-ninja",
      "configurePreset": "gcc16-ninja"
    },
    {
      "name": "gcc16-ninja-nocuda",
      "configurePreset": "gcc16-ninja-nocuda"
    }
  ]
}
